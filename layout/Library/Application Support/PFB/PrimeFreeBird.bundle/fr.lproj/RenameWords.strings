/* French word replacements for "Restore Twitter terminology", read like the English table.
   "poste" and "postes" stay out: they also name a position. */

"post" = "Tweet";
"posts" = "Tweets";
"poster" = "tweeter";
"postez" = "tweetez";
"postent" = "tweetent";
"posté" = "tweeté";
"postée" = "tweetée";
"postés" = "tweetés";
"postées" = "tweetées";
"postant" = "tweetant";
"repost" = "Retweet";
"reposts" = "Retweets";
"reposter" = "retweeter";
"reposte" = "retweete";
"repostez" = "retweetez";
"repostent" = "retweetent";
"reposté" = "retweeté";
"repostée" = "retweetée";
"repostés" = "retweetés";
"repostant" = "retweetant";
"Premium" = "Blue";
"X" = "Twitter";

/* Whole phrases where "publication" names a Tweet; the word alone also means publishing. */
"À propos de cette publication" = "À propos de ce Tweet";
"Citation d'une publication" = "Citation d'un Tweet";
"a épinglé une publication" = "a épinglé un Tweet";
"Mettez vos meilleures publications" = "Mettez vos meilleurs Tweets";
