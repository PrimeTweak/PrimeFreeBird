<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>COMPAT_PROBLEM_COUNT</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%lu problem</string>
			<key>few</key>
			<string>%lu problemy</string>
			<key>many</key>
			<string>%lu problemów</string>
			<key>other</key>
			<string>%lu problemu</string>
		</dict>
	</dict>
	<key>COMPAT_OPTION_COUNT</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%lu opcja</string>
			<key>few</key>
			<string>%lu opcje</string>
			<key>many</key>
			<string>%lu opcji</string>
			<key>other</key>
			<string>%lu opcji</string>
		</dict>
	</dict>
	<key>TOUR_SCREEN_COUNT</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>%lu ekran</string>
			<key>few</key>
			<string>%lu ekrany</string>
			<key>many</key>
			<string>%lu ekranów</string>
			<key>other</key>
			<string>%lu ekranu</string>
		</dict>
	</dict>
	<key>TOUR_SCREENS_LEFT</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lu</string>
			<key>one</key>
			<string>pozostał %lu</string>
			<key>few</key>
			<string>pozostały %lu</string>
			<key>many</key>
			<string>pozostało %lu</string>
			<key>other</key>
			<string>pozostało %lu</string>
		</dict>
	</dict>
</dict>
</plist>
